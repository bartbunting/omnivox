;;; emacsvox-native-lightweight-check.el --- Local deployment probe -*- lexical-binding: t; -*-
(require 'cl-lib)
(require 'json)
(defun native-personal--ready-p (process)
  "Observe acknowledgement of the actual saved startup voice definitions."
  (condition-case nil
      (let ((snapshot (omnivox--choice-current-registration process)))
        (and (eql (plist-get snapshot :registry-generation)
                  (process-get process 'omnivox--highest-sent-registry-generation))
             (omnivox--native-registration-content-equal-p
              (omnivox--process-logical-registry-content process)
              (plist-get snapshot :content))))
    (error nil)))
(let ((source (file-name-as-directory (getenv "EMACSVOX_DIR")))
      (personal (getenv "EMACSVOX_NATIVE_PERSONAL_CHECK"))
      (emacsvox-speak-messages nil) engines results failure)
  (unless (eq system-type 'windows-nt) (error "Expected native Windows Emacs"))
  (unless personal
    (setq user-emacs-directory (file-name-as-directory (getenv "EMACSVOX_NATIVE_PROBE_ROOT"))
          custom-file (expand-file-name "custom.el" user-emacs-directory)
          emacsvox-user-directory (expand-file-name "resources" user-emacs-directory)
          tts-notification-device nil)
    (make-directory user-emacs-directory t)
    (load (expand-file-name "lisp/emacsvox-setup.el" source) nil nil t)
    (tts-initialize))
  (unwind-protect
      (condition-case err
          (progn
            (unless (file-in-directory-p
                     (symbol-file 'omnivox--schedule-discovery-refresh 'defun) source)
              (error "Wrong speech client loaded"))
            (when personal
              (unless (and (eq window-system 'w32)
                           (equal user-full-name "Bart Bunting")
                           (bound-and-true-p vertico-mode)
                           (bound-and-true-p global-corfu-mode)
                           (eq (key-binding (kbd "C-c a")) #'org-agenda)
                           (eq (key-binding (kbd "H-e")) #'my/open-in-windows-explorer)
                           (eq (key-binding (kbd "H-t")) #'my/open-or-focus-microsoft-teams)
                           (eq emacsvox-sounds-current-pack 'bart))
                (error "Native personal profile did not finish loading")))
            (dolist (lane (list tts-speaker-process tts-notify-process))
              (let ((deadline (+ (float-time) 45)))
                (while (and (< (float-time) deadline)
                            (not (native-personal--ready-p lane)))
                  (accept-process-output nil .02)))
              (unless (and (process-live-p lane)
                           (native-personal--ready-p lane)
                           (omnivox-library--owned-p lane)
                           (process-live-p (process-get lane 'omnivox-native-guard))
                           (equal "windows-pipe" (plist-get (process-get lane 'omnivox-native-guard-endpoint) :transport)))
                (error "Native speech lane is not ready: %S" lane))
              (let ((tts-speaker-process lane) completed engine
                    (deadline (+ (float-time) 30)))
                (tts-speak-marked
                 "The updated native Windows speech build is ready."
                 (lambda (_ event)
                   (when (equal (plist-get event :type) "utterance_started")
                     (setq engine (plist-get event :engine_id))))
                 (lambda (_ status) (setq completed status)))
                (while (and (not completed) (< (float-time) deadline))
                  (accept-process-output nil .02))
                (unless (and (eq completed 'completed)
                             (equal engine (getenv "OMNIVOX_ENGINE")))
                  (error "Speech failed: %S %S" completed engine))
                (push engine engines)))
            (require 'omnivox-preferences)
            (omnivox-reload-preferences (lambda (value) (setq results value)))
            (let ((deadline (+ (float-time) 15)))
              (while (and (not results) (< (float-time) deadline))
                (accept-process-output nil .02)))
            (unless (and (= (length results) 2)
                         (cl-every (lambda (r) (equal (plist-get r :outcome) "unchanged")) results))
              (error "Preference reload failed: %S" results)))
        (error (setq failure (error-message-string err))
               (with-temp-file (concat (getenv "EMACSVOX_NATIVE_PROBE_RESULT") ".diagnostics")
                 (dolist (buffer (buffer-list))
                   (when (or (equal (buffer-name buffer) "*Messages*")
                             (string-match-p "diagnostics" (buffer-name buffer)))
                     (insert "\n" (buffer-name buffer) "\n")
                     (insert (with-current-buffer buffer
                               (buffer-substring-no-properties
                                (max (point-min) (- (point-max) 20000)) (point-max)))))))))
    (dolist (owner (delete-dups (append (list tts-speaker-process tts-notify-process)
                                      omnivox-native-guard--owners)))
      (when (processp owner)
        (condition-case err
            (if (omnivox-library--owned-p owner)
                (omnivox-library--retire-for-emergency owner)
              (tts--retire-process owner))
          (error (setq failure (concat (or failure "") " Cleanup: " (error-message-string err))))))))
  (with-temp-file (getenv "EMACSVOX_NATIVE_PROBE_RESULT")
    (insert (json-serialize
             (list :result (if failure "failed" "passed") :error failure
                   :native_emacs emacs-version :personal_profile (if personal t :false)
                   :client (symbol-file 'omnivox--schedule-discovery-refresh 'defun)
                   :runtime (getenv "TTS_PROGRAM") :engines (vconcat (nreverse engines))
                   :reload (vconcat (mapcar (lambda (r)
                             (list :role (plist-get r :role) :outcome (plist-get r :outcome)
                                   :reason (plist-get r :reason))) results)) :client_process_cleanup (if failure "see error" "retired")))))
  (when (boundp 'native-registry-trace)
    (with-temp-file (concat (getenv "EMACSVOX_NATIVE_PROBE_RESULT") ".registry-trace")
      (let ((print-length nil) (print-level nil))
        (prin1 (reverse native-registry-trace) (current-buffer)))))
  (when failure (let ((emacsvox-speak-messages nil)) (message "%s" failure)))
  (kill-emacs (if failure 1 0)))
