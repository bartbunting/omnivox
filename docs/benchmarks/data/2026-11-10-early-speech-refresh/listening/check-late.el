;;; check-late.el --- Saved choices during automatic discovery -*- lexical-binding: t; -*-
(require 'cl-lib)
(defun early-check-wait (predicate)
  (let ((deadline (+ (float-time) 45)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil .02))
    (unless (funcall predicate) (error "Automatic discovery check timed out"))))
(defun early-check-engine (p)
  (cl-find "rutts" (append (plist-get (process-get p omnivox--control-inventory-property) :engines) nil)
           :key (lambda (entry) (plist-get entry :id)) :test #'equal))
(let ((root (getenv "OMNIVOX_LISTENING_ROOT"))
      (case (getenv "OMNIVOX_DISCOVERY_CHECK_CASE")) failure observations)
  (unwind-protect
      (condition-case err
          (progn
            (unless (string-suffix-p ".elc" (symbol-file 'omnivox--schedule-discovery-refresh 'defun))
              (error "Discovery code is not compiled"))
            (unless (equal omnivox-global-default-selector '(exact "rutts" "voice"))
              (error "Saved exact preference was not loaded"))
            (unless (omnivox--discovery-pending-p
                     (process-get tts-speaker-process omnivox--control-inventory-property))
              (error "Optional discovery was not pending at client readiness"))
            (omnivox-listening--check "flite")
            (tts-notify-apply (lambda (_) (omnivox-listening--check "flite")) nil)
            (when (equal case "changed")
              (setq omnivox-engine-priority-ids '("flite")
                    omnivox-global-default-selector '(engine-default "flite"))
              (let (result)
                (omnivox-apply-voice-configuration (lambda (value) (setq result value)))
                (early-check-wait (lambda () result))
                (unless (eq (plist-get result :status) 'applied) (error "Selection failed: %S" result))))
            (when (equal case "restart")
              (tts-restart)
              (unless (process-get tts-speaker-process 'omnivox--discovery-timer)
                (error "Prepared replacement lost discovery refresh"))
              (omnivox-listening--check "flite"))
            ;; Observe client caches only.  No explicit inventory request or registration.
            (early-check-wait
             (lambda ()
               (cl-every
                (lambda (p)
                  (and (not (omnivox--discovery-pending-p
                             (process-get p omnivox--control-inventory-property)))
                       (= 0 (hash-table-count (omnivox--pending-requests p)))))
                (list tts-speaker-process tts-notify-process))))
            (dolist (p (list tts-speaker-process tts-notify-process))
              (push (early-check-engine p) observations)
              (when (process-get p 'omnivox--discovery-timer) (error "Polling did not finish")))
            (unless (equal omnivox-global-default-selector
                           (if (equal case "changed") '(engine-default "flite") '(exact "rutts" "voice")))
              (error "Discovery altered current saved preferences"))
            (let ((expected (if (member case '("changed" "failed")) "flite" "rutts")))
              (omnivox-listening--check expected)
              (tts-notify-apply (lambda (_) (omnivox-listening--check expected)) nil))
            (with-temp-file (expand-file-name "late-check.txt" root)
              (insert (format "PASS %s: fallback while pending, automatic independent observations, current preferences retained, final speech both lanes.\n%S\n" case observations))))
        (error
         (setq failure (error-message-string err))
         (with-temp-file (expand-file-name "client-messages.txt" root)
           (insert (with-current-buffer "*Messages*" (buffer-string))))
         (with-temp-file (expand-file-name "discovery-state.txt" root)
           (prin1 (mapcar (lambda (p)
                           (list (process-name p) (early-check-engine p)
                                 (and (process-get p 'omnivox--discovery-timer) t)
                                 (process-get p 'omnivox--discovery-deadline)
                                 (hash-table-count (omnivox--pending-requests p))))
                         (list tts-speaker-process tts-notify-process)) (current-buffer)))))
    (dolist (p (delete-dups (append (list tts-speaker-process tts-notify-process) omnivox-native-guard--owners)))
      (when (processp p) (omnivox-library--retire-for-emergency p))))
  (when failure (with-temp-file (expand-file-name "late-error.txt" root) (insert failure)))
  (kill-emacs (if failure 1 0)))
