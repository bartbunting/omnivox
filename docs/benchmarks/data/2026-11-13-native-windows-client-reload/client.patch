diff --git a/lisp/speech/omnivox-library-runtime.el b/lisp/speech/omnivox-library-runtime.el
index 0bae16be3..c8ad36061 100644
--- a/lisp/speech/omnivox-library-runtime.el
+++ b/lisp/speech/omnivox-library-runtime.el
@@ -77,6 +77,21 @@
 (defconst omnivox-library--prefix "OMNIVOX-LOCAL ")
 (defconst omnivox-library--timeout 45)
 
+(defun omnivox-library--local-target-p (program)
+  "Whether PROGRAM can negotiate local ownership and management.
+The bundled POSIX launcher translates client engine-file settings.  Native
+Windows uses its selected local Omnivox executable and native environment;
+it does not acquire that separate launcher settings provider."
+  (and (stringp program)
+       (not (omnivox-remote-enabled-p))
+       (or (omnivox-engine-settings--supported-p)
+           (and (eq system-type 'windows-nt)
+                (string-match-p "\\`[[:alpha:]]:[/\\\\]" program)
+                (not (string-match-p "[\0\r\n]" program))
+                (equal (downcase (file-name-nondirectory
+                                  (subst-char-in-string ?\\ ?/ program)))
+                       "omnivox.exe")))))
+
 (defun omnivox-library--source-key ()
   "Identify the selected launcher and native library location."
   (let ((program (tts--resolve-program tts-program)))
@@ -141,8 +156,8 @@ Cancellation suppresses CALLBACK.  Capability discovery is asynchronous too."
                                (lambda () (finish nil "Voice library inspection timed out"))))
       (condition-case err
           (cond
-           ((not (and program (omnivox-engine-settings--supported-p)))
-            (finish nil "Voice management requires the bundled local Omnivox launcher"))
+           ((not (omnivox-library--local-target-p program))
+            (finish nil "Voice management requires a supported local Omnivox executable or launcher"))
            ((assoc key omnivox-library--support-cache)
             (if (cdr (assoc key omnivox-library--support-cache)) (inspect)
               (finish nil "This launcher does not support voice management")))
@@ -180,7 +195,7 @@ Cancellation suppresses CALLBACK.  Capability discovery is asynchronous too."
 
 (defun omnivox-library--supported-p (program)
   "Check PROGRAM's ordinary help before using its local owner extension."
-  (and (omnivox-engine-settings--supported-p)
+  (and (omnivox-library--local-target-p program)
        (let* ((key (list program (getenv "OMNIVOX_PROGRAM")
                          (file-attribute-modification-time (file-attributes program))))
               (cached (assoc key omnivox-library--support-cache)))
@@ -435,7 +450,7 @@ This check does not publish capability or routing readiness hooks."
   (require 'omnivox-voices)
   (let ((program (tts--resolve-program tts-program)))
     (unless (and program (omnivox-library--supported-p program))
-      (user-error "Installed voices require the updated bundled local Omnivox launcher"))
+      (user-error "Local management requires an updated local Omnivox executable or launcher"))
     (let ((process-environment (omnivox-engine-settings--environment program)))
       (when (eq role 'notification)
         (dolist (variable '("ALSA_DEFAULT" "SWIFTMAC_AUDIO_TARGET" "SHARPWIN_AUDIO_TARGET" "PULSE_SINK"))
diff --git a/test/omnivox-library-tests.el b/test/omnivox-library-tests.el
index 40869c9c7..eb2540190 100644
--- a/test/omnivox-library-tests.el
+++ b/test/omnivox-library-tests.el
@@ -7,6 +7,63 @@
 (require 'omnivox-library)
 (require 'omnivox-voices)
 
+(ert-deftest omnivox-library-native-owner-negotiates-without-posix-settings ()
+  (let ((emacs (expand-file-name invocation-name invocation-directory))
+        (platform system-type)
+        (native-comp-enable-subr-trampolines nil)
+        (spawn (symbol-function 'make-process)))
+    (dolist (help '("Usage: omnivox --voice-library-owner" "Usage: old omnivox"))
+      (let* ((system-type 'windows-nt)
+             (tts-program "C:\\Speech files\\voix-é\\Omnivox.exe")
+             (omnivox-native-guard--enabled t)
+             (omnivox--library-startup nil) (omnivox--emergency-output nil)
+             (omnivox-library--support-cache nil) (calls 0))
+        (cl-letf (((symbol-function 'omnivox-remote-enabled-p) #'ignore)
+                  ((symbol-function 'file-attributes) (lambda (&rest _) nil))
+                  ((symbol-function 'make-process)
+                   (lambda (&rest args)
+                     (should (equal (plist-get args :command) (list tts-program "--help")))
+                     (cl-incf calls)
+                     (let ((system-type platform))
+                       (apply spawn (plist-put args :command
+                                               (list emacs "-Q" "--batch" "--eval"
+                                                     (format "(princ %S)" help))))))))
+          (should-not (omnivox-engine-settings--supported-p))
+          (dotimes (_ 2)
+            (should (equal (omnivox-library--command tts-program)
+                           (if (string-search "--voice-library-owner" help)
+                               (list tts-program "--voice-library-owner" "--guarded")
+                             (list tts-program)))))
+          (should (= calls 1)))))))
+
+(ert-deftest omnivox-library-native-owner-rejects-remote-and-unrelated-targets ()
+  (let ((system-type 'windows-nt)
+        (omnivox-native-guard--enabled nil) (omnivox--library-startup nil)
+        (omnivox--emergency-output nil) (omnivox-library--support-cache nil))
+    (dolist (program '("omnivox.exe" "C:omnivox.exe" "C:/Speech/other.exe"
+                       "//host/share/omnivox.exe" "\\\\host\\share\\omnivox.exe"
+                       "/ssh:host:/omnivox.exe" "C:/bad\npath/omnivox.exe"))
+      (let ((tts-program program))
+        (cl-letf (((symbol-function 'omnivox-remote-enabled-p) #'ignore)
+                  ((symbol-function 'make-process)
+                   (lambda (&rest _) (ert-fail "Ineligible target started local management"))))
+          (should (equal (omnivox-library--command program) (list program))))))
+    (let ((tts-program "C:/Speech/omnivox.exe"))
+      (cl-letf (((symbol-function 'omnivox-remote-enabled-p) (lambda () t))
+                ((symbol-function 'make-process)
+                 (lambda (&rest _) (ert-fail "Remote speech started local management"))))
+        (should (equal (omnivox-library--command tts-program) (list tts-program)))))))
+
+(ert-deftest omnivox-library-native-owner-keeps-native-environment ()
+  (let ((system-type 'windows-nt) (tts-program "C:/Speech/omnivox.exe")
+        (process-environment '("OMNIVOX_ECI_DLL=C:\\Voice files\\eci.dll"))
+        (omnivox-eloquence-runtime-file "/unused/posix/eci.dll"))
+    (cl-letf (((symbol-function 'omnivox-remote-enabled-p) #'ignore))
+      (should (omnivox-library--local-target-p tts-program))
+      (should-not (omnivox-engine-settings--supported-p))
+      (should (eq process-environment (omnivox-engine-settings--environment tts-program)))
+      (should (equal (getenv "OMNIVOX_ECI_DLL") "C:\\Voice files\\eci.dll")))))
+
 (ert-deftest omnivox-library-selection-rejects-changed-target-and-releases-service ()
   (dolist (failure '(target request))
     (let ((service (make-pipe-process :name "selection fixture" :noquery t))
