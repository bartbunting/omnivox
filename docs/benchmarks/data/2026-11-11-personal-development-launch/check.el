;;; check.el --- Native speech smoke check without loading personal integrations -*- lexical-binding: t; -*-
(require 'cl-lib)
(let* ((source (file-name-as-directory (getenv "EMACSVOX_DIR")))
       (scratch (make-temp-file "omnivox-personal-check-" t)) failure)
  (setq user-emacs-directory (file-name-as-directory scratch)
        custom-file (expand-file-name "custom.el" scratch)
        emacsvox-user-directory (expand-file-name "resources" scratch)
        tts-notification-device nil)
  (add-to-list 'load-path (expand-file-name "lisp" source))
  (require 'emacsvox-preamble)
  (load (expand-file-name "lisp/emacsvox-setup.el" source) nil nil t)
  (unwind-protect
      (condition-case err
          (progn
            (tts-initialize)
            (let ((deadline (+ (float-time) 20)))
              (while (and (not (process-get tts-speaker-process omnivox--choice-registration-property))
                          (< (float-time) deadline))
                (accept-process-output nil .01)))
            (unless (process-live-p (process-get tts-speaker-process 'omnivox-native-guard))
              (error "Native guard is missing"))
            (let ((deadline (+ (float-time) 20)) completed engine)
              (tts-speak-marked "The development speech runtime is ready."
                                (lambda (_ event)
                                  (when (equal (plist-get event :type) "utterance_started")
                                    (setq engine (plist-get event :engine_id))))
                                (lambda (_ status) (setq completed status)))
              (while (and (not completed) (< (float-time) deadline))
                (accept-process-output nil .01))
              (unless (and (eq completed 'completed) engine)
                (error "Speech did not complete: %S %S" completed engine))
              (princ (format "PASS guarded %s source speech; persistent development engine configuration.\n" engine)))
            (unless (string-prefix-p source (symbol-file 'omnivox--schedule-discovery-refresh 'defun))
              (error "Wrong client checkout")))
        (error (setq failure (error-message-string err))))
    (dolist (p (delete-dups (append (list tts-speaker-process tts-notify-process) omnivox-native-guard--owners)))
      (when (processp p) (omnivox-library--retire-for-emergency p))))
  (when failure (error "%s" failure)))
