;;; check-late.el --- Discovery publication and actual client registration -*- lexical-binding: t; -*-
(require 'cl-lib)
(defun early-check-wait (predicate)
  (let ((deadline (+ (float-time) 20)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil .02))
    (unless (funcall predicate) (error "Late discovery check timed out"))))
(defun early-check-engine ()
  (cl-find "rutts" (append (plist-get (omnivox-library--control tts-speaker-process '(:type "inventory")) :engines) nil)
           :key (lambda (entry) (plist-get entry :id)) :test #'equal))
(let ((root (getenv "OMNIVOX_LISTENING_ROOT")) failure)
  (unwind-protect
      (condition-case err
          (progn
            (unless (equal "unavailable" (plist-get (plist-get (early-check-engine) :availability) :status))
              (error "Optional discovery was not pending at client readiness"))
            (omnivox-listening--check "flite")
            (let ((tts-speaker-process tts-notify-process)) (omnivox-listening--check "flite"))
            (early-check-wait (lambda ()
              (cl-every (lambda (p)
                          (let ((tts-speaker-process p))
                            (equal "available" (plist-get (plist-get (early-check-engine) :availability) :status))))
                        (list tts-speaker-process tts-notify-process))))
            (omnivox-refresh-voice-inventory)
            (early-check-wait (lambda () (cl-every (lambda (p) (= 0 (hash-table-count (omnivox--pending-requests p)))) (list tts-speaker-process tts-notify-process))))
            (omnivox-listening--check "flite")
            (setq omnivox-engine-priority-ids '("rutts"))
            (let (result)
              (omnivox-apply-voice-configuration (lambda (value) (setq result value)))
              (early-check-wait (lambda () result)))
            (omnivox-listening--check "rutts")
            (let ((tts-speaker-process tts-notify-process)) (omnivox-listening--check "rutts"))
            (with-temp-file (expand-file-name "late-check.txt" root)
              (insert "PASS initial pending inventory, both lanes speaking, late refresh, preserved Flite, explicit later selection on both lanes.\n")))
        (error (setq failure (error-message-string err))))
    (dolist (p (delete-dups (append (list tts-speaker-process tts-notify-process) omnivox-native-guard--owners)))
      (when (processp p) (omnivox-library--retire-for-emergency p))))
  (when failure (with-temp-file (expand-file-name "late-error.txt" root) (insert failure)))
  (kill-emacs (if failure 1 0)))
