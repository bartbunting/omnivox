@@ -0,0 +1,140 @@
+//! Private launch authority captured before the owner can retire old speech.
+use super::helper_wire;
+use anyhow::{Context, Result};
+use omnivox_tts::engine_configuration::EngineOrigin;
+use omnivox_tts::helper_engine::HelperEngineConfig;
+use omnivox_tts::voice_library::local::Startup;
+use sha2::{Digest, Sha256};
+use std::fs::File;
+use std::io::{Read, Seek};
+use std::path::{Path, PathBuf};
+
+#[derive(Clone)]
+pub(super) struct Helper {
+    pub config: HelperEngineConfig,
+    pub identity: String,
+    image: Image,
+}
+#[derive(Clone)]
+pub(super) struct Plan {
+    pub helper: Option<Helper>,
+}
+
+impl Plan {
+    pub fn validate(startup: &Startup) -> Result<()> {
+        let snapshot = startup
+            .engines
+            .as_ref()
+            .context("guard requires an engine snapshot")?;
+        for entry in snapshot
+            .resolved()
+            .registrations()
+            .filter(|entry| entry.enabled)
+        {
+            anyhow::ensure!(
+                matches!(entry.engine_id.as_str(), "espeak" | "flite")
+                    && entry.origin != EngineOrigin::ExternalHelper,
+                "Windows guarded startup currently supports explicit eSpeak/Flite configurations; unsupported engine: {}",
+                entry.engine_id
+            );
+        }
+        Ok(())
+    }
+    pub fn prepare(startup: &Startup) -> Result<Self> {
+        Self::validate(startup)?;
+        let helper = startup
+            .engines
+            .as_ref()
+            .unwrap()
+            .resolved()
+            .registration("flite")
+            .filter(|entry| entry.enabled && entry.unavailable.is_none())
+            .and_then(|entry| entry.helper.clone())
+            .map(Helper::capture)
+            .transpose()?;
+        Ok(Self { helper })
+    }
+}
+
+impl Helper {
+    pub(super) fn capture(config: HelperEngineConfig) -> Result<Self> {
+        let identity = helper_wire::identity(
+            &config.engine_id,
+            &config.program,
+            &config.arguments,
+            &config.environment,
+        )?;
+        let image = Image::capture(&config.program)?;
+        Ok(Self {
+            config,
+            identity,
+            image,
+        })
+    }
+    pub fn verify(&self) -> Result<File> {
+        self.image.verify()
+    }
+}
+
+// Keep native paths intact. This private fingerprint is not a new management
+// record. Verification remains at creation, never on ordinary speech requests.
+#[derive(Clone)]
+struct Image {
+    path: PathBuf,
+    bytes: u64,
+    hash: [u8; 32],
+}
+impl Image {
+    fn open(path: &Path) -> Result<File> {
+        anyhow::ensure!(
+            path.is_absolute() && std::fs::metadata(path)?.is_file(),
+            "guard helper must be an absolute regular file"
+        );
+        let file = File::open(path)?;
+        anyhow::ensure!(
+            file.metadata()?.is_file(),
+            "guard helper is not a regular file"
+        );
+        Ok(file)
+    }
+    fn digest(file: &mut File, size: u64) -> Result<[u8; 32]> {
+        let before = file.metadata()?;
+        anyhow::ensure!(before.len() == size, "guard helper size changed");
+        let mut hash = Sha256::new();
+        let mut remaining = size;
+        let mut buffer = [0; 65536];
+        while remaining > 0 {
+            let limit = remaining.min(buffer.len() as u64) as usize;
+            let n = file.read(&mut buffer[..limit])?;
+            anyhow::ensure!(n > 0, "guard helper truncated");
+            hash.update(&buffer[..n]);
+            remaining -= n as u64;
+        }
+        anyhow::ensure!(file.read(&mut [0])? == 0, "guard helper grew");
+        let after = file.metadata()?;
+        anyhow::ensure!(
+            after.len() == size && after.modified().ok() == before.modified().ok(),
+            "guard helper changed during verification"
+        );
+        file.rewind()?;
+        Ok(hash.finalize().into())
+    }
+    fn capture(path: &Path) -> Result<Self> {
+        let mut file = Self::open(path)?;
+        let bytes = file.metadata()?.len();
+        let hash = Self::digest(&mut file, bytes)?;
+        Ok(Self {
+            path: path.into(),
+            bytes,
+            hash,
+        })
+    }
+    fn verify(&self) -> Result<File> {
+        let mut file = Self::open(&self.path)?;
+        anyhow::ensure!(
+            Self::digest(&mut file, self.bytes)? == self.hash,
+            "guard helper executable changed"
+        );
+        Ok(file)
+    }
+}
