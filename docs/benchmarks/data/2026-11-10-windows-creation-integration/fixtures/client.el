(require 'cl-lib)
(defvar emergency-test--root
  (file-name-as-directory
   (or (getenv "OMNIVOX_TEST_SOURCE_ROOT")
       (expand-file-name "../" (file-name-directory load-file-name)))))
(add-to-list 'load-path (expand-file-name "lisp/" emergency-test--root))
(setq load-prefer-newer (not (getenv "OMNIVOX_TEST_BYTECODE")))
(require 'emacsvox-preamble)
(require 'tts-speak)
(require 'omnivox-library-runtime)
(require 'omnivox-voices)
(unless (getenv "OMNIVOX_TEST_BYTECODE")
  (dolist (file '("omnivox-native-guard.el" "tts-speak.el" "tts-lifecycle.el" "omnivox-library-runtime.el" "omnivox-voices.el"))
    (load file nil nil)))
(when-let* ((legacy (getenv "OMNIVOX_TEST_LEGACY_ROOT")))
  (load (expand-file-name "omnivox-library-runtime.elc" legacy) nil nil t)
  (load (expand-file-name "omnivox-native-guard.elc" legacy) nil nil t))
(setq omnivox-native-guard--enabled t)
(setq emacsvox-servers-directory (expand-file-name "servers/" emergency-test--root)
      tts-program "omnivox" tts-notification-device "both" emacsvox-speak-messages nil
      debug-on-error t)
(dolist (function '(tts-emergency-start tts--recover-speaker omnivox-library--retire-for-emergency omnivox-native-guard--retire))
  (let ((file (symbol-file function 'defun)))
    (unless (and (string-prefix-p (if (memq function '(omnivox-library--retire-for-emergency omnivox-native-guard--retire))
                                          (or (getenv "OMNIVOX_TEST_LEGACY_ROOT") emergency-test--root)
                                        emergency-test--root) file)
                 (string-suffix-p (if (getenv "OMNIVOX_TEST_BYTECODE") ".elc" ".el") file))
      (error "Wrong implementation %S: %S" function file))
    (princ (format "Loaded %s from %s\n" function file))))
(unless (and (getenv "OMNIVOX_PROGRAM") (getenv "OMNIVOX_TEST_CONFIG_DIR")
             (getenv "OMNIVOX_TEST_VOICE_ROOT"))
  (error "Explicit isolated executable, configuration and voice root required"))

(defun emergency-test--wait (predicate)
  (let ((deadline (+ (float-time) 10)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil .005))
    (unless (funcall predicate) (error "Emergency observation timed out"))))

(defun emergency-test--speech (engine)
  (emergency-test--wait
   (lambda () (and (condition-case nil (omnivox--choice-current-registration tts-speaker-process)
                    (error nil))
                  (cl-every
                   (lambda (process)
                     (let ((pending (process-get process omnivox--control-pending-property)))
                       (or (not pending) (= 0 (hash-table-count pending)))))
                   (list tts-speaker-process tts-notify-process)))))
  (let ((start (float-time)) terminal actual first)
    (tts-speak-marked "Emergency speech works."
                      (lambda (_id record)
                        (when (equal (plist-get record :type) "utterance_started")
                          (setq actual (plist-get record :engine_id))
                          (unless first (setq first (float-time)))))
                      (lambda (_id status) (setq terminal status)))
    (emergency-test--wait (lambda () terminal))
    (unless (and (eq terminal 'completed) (equal actual engine))
      (error "Wrong speech result: %S %S" terminal actual))
    (princ (format "Speech %s source %.3f ms, completion %.3f ms\n"
                   engine (* 1000 (- first start)) (* 1000 (- (float-time) start))))
    (list :submitted start :first first :completed (float-time))))

(defun emergency-test--fingerprints (root)
  (mapcar (lambda (file)
            (cons file (with-temp-buffer (insert-file-contents-literally file)
                                         (secure-hash 'sha256 (current-buffer)))))
          (directory-files-recursively root ".")))



(defvar emergency-profile--active nil)
(defvar emergency-profile--start 0)
(defvar emergency-profile--depth 0)
(defvar emergency-profile--spans nil)
(defvar emergency-profile--operations nil)
(when (getenv "OMNIVOX_TEST_PROFILE")
  (dolist (name '(omnivox-library--emergency-supported omnivox-library--prepare-emergency
                  omnivox-library--release-emergency omnivox-library--retire-for-emergency
                  tts-make-process omnivox-library--owner omnivox-library--acknowledge-engines
                  omnivox-library--wait-for-recovered-speech omnivox-library--request
                  omnivox-library--control voice-setup make-process omnivox-native-guard--connect omnivox-native-guard--request))
    (when (fboundp name)
      (let ((function name))
        (advice-add name :around
                    (lambda (original &rest arguments)
                      (if (not emergency-profile--active) (apply original arguments)
                        (let ((start (float-time)) (depth emergency-profile--depth)
                              (emergency-profile--depth (1+ emergency-profile--depth)))
                          (unwind-protect (apply original arguments)
                            (push (list :function (symbol-name function) :depth depth
                                        :start_ms (* 1000 (- start emergency-profile--start))
                                        :ms (* 1000 (- (float-time) start))
                                        :command (when (memq function '(omnivox-library--request omnivox-library--control))
                                                   (or (plist-get (cadr arguments) :command)
                                                       (plist-get (cadr arguments) :type))))
                                  emergency-profile--spans))))))))))
(advice-add 'tts-emergency-start :around
            (lambda (original &rest arguments)
              (let ((emergency-profile--active t) (emergency-profile--depth 0)
                    (emergency-profile--start (float-time)) (emergency-profile--spans nil) success)
                (unwind-protect (prog1 (apply original arguments) (setq success t))
                  (push (list :ms (* 1000 (- (float-time) emergency-profile--start))
                              :success (if success t :false)
                              :spans (vconcat (nreverse emergency-profile--spans)))
                        emergency-profile--operations)))))


(let ((records nil))
  (unwind-protect
      (progn
        (tts-initialize)
        (emergency-test--speech "flite")
        (let ((peer tts-notify-process))
          (dolist (mode '(paused killed repeated lost-reply disconnected))
            (let* ((old tts-speaker-process)
                   (root (getenv "OMNIVOX_TEST_VOICE_ROOT"))
                   (sessions (expand-file-name "sessions" root)))
              (with-temp-file (expand-file-name "config.json" (getenv "OMNIVOX_TEST_CONFIG_DIR"))
                (insert "{broken preferences"))
              (with-temp-file (expand-file-name "host.json" root) (insert "{broken host"))
              (unless (getenv "OMNIVOX_TEST_WINDOWS_DATA") (set-file-modes sessions #o500))
              (let ((before (emergency-test--fingerprints root))
                    (start (float-time)))
                (pcase mode
                  ((or 'paused 'lost-reply) (signal-process old 'SIGSTOP))
                  ('killed (delete-process old))
                  ('disconnected
                   (delete-process (process-get old 'omnivox-native-guard))
                   (let ((endpoint (process-get old 'omnivox-native-guard-endpoint)))
                     (emergency-test--speech "espeak")
                     (omnivox-native-guard--request old "status")
                     (unless (equal endpoint (process-get old 'omnivox-native-guard-endpoint))
                       (error "Reconnection replaced native authority")))))
                (if (eq mode 'lost-reply)
                    (let ((request (symbol-function 'omnivox-native-guard--request)) dropped rejected)
                      (cl-letf (((symbol-function 'omnivox-native-guard--request)
                                 (lambda (process command)
                                   (let ((reply (funcall request process command)))
                                     (if (and (eq process old) (equal command "retire") (not dropped))
                                         (progn (setq dropped t) (error "Injected lost guard reply"))
                                       reply)))))
                        (condition-case nil (tts-emergency-start "null") (error (setq rejected t))))
                      (unless (and dropped rejected (eq old tts-speaker-process))
                        (error "Lost reply was not retained safely"))
                      (tts-emergency-start "null"))
                  (tts-emergency-start "null"))
                (let ((ready (float-time))
                      (speech (emergency-test--speech "espeak")))
                  (unless (and (not (eq old tts-speaker-process))
                               (process-get old 'omnivox-native-guard-proof)
                               (eq tts-notify-process peer)
                               (or (getenv "OMNIVOX_TEST_WINDOWS_DATA")
                                   (equal before (emergency-test--fingerprints root))))
                    (error "Guarded recovery changed its peer, claims, or lacks proof"))
                  (let ((tts-speaker-process peer)) (emergency-test--speech "flite"))
                  (push (list :case (symbol-name mode) :ready_ms (* 1000 (- ready start))
                              :source_ms (* 1000 (- (plist-get speech :first) start))) records)
                  (princ (format "PASS %s independent guard, minimal speech and healthy peer\n" mode))))))))
    (dolist (process (delete-dups (append (list tts-speaker-process tts-notify-process
                                             omnivox-library--emergency-pending)
                                       omnivox-native-guard--owners)))
      (when (processp process)
        (condition-case err (omnivox-library--retire-for-emergency process)
          (error (princ (format "Cleanup failed: %S\n" err))))))
    (let ((sessions (expand-file-name "sessions" (getenv "OMNIVOX_TEST_VOICE_ROOT"))))
      (when (file-directory-p sessions) (set-file-modes sessions #o700))))
  (with-temp-file (expand-file-name "result.json" (getenv "OMNIVOX_TEST_CONFIG_DIR"))
    (insert (json-serialize (vconcat (nreverse records))))))

(with-temp-file (expand-file-name "profile.json" (getenv "OMNIVOX_TEST_CONFIG_DIR"))
  (insert (json-serialize (list :variant (if (getenv "OMNIVOX_TEST_LEGACY_ROOT") "legacy" "deferred")
                               :profiled (if (getenv "OMNIVOX_TEST_PROFILE") t :false)
                               :operations (vconcat (nreverse emergency-profile--operations)))
                          :null-object nil :false-object :false)))
(when-let* ((buffer (tts--diagnostic-buffer "Speaker")))
  (with-current-buffer buffer
    (write-region (point-min) (point-max)
                  (expand-file-name "native-diagnostics.log" (getenv "OMNIVOX_TEST_CONFIG_DIR")) nil 'silent)))
